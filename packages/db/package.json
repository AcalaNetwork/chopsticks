{
	"name": "@acala-network/chopsticks-db",
	"version": "1.6.1",
	"repository": {
		"type": "git",
		"url": "https://github.com/AcalaNetwork/chopsticks"
	},
	"author": "Acala Developers <hello@acala.network>",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=v24"
	},
	"scripts": {
		"clean": "rm -rf dist tsconfig.tsbuildinfo",
		"build": "bun run clean && ../../package-build.sh",
		"depcheck": "bunx depcheck"
	},
	"dependencies": {
		"@acala-network/chopsticks-core": "workspace:*",
		"@polkadot/util": "^14.0.3",
		"idb": "^8.0.4",
		"reflect-metadata": "^0.2.2",
		"better-sqlite3": "^13.1.1",
		"typeorm": "^1.1.3"
	},
	"devDependencies": {
		"@swc/cli": "0.8.2",
		"@swc/core": "^1.16.22",
		"typescript": "^6.0.3"
	},
	"files": [
		"dist/esm/**",
		"dist/cjs/**"
	],
	"main": "./dist/cjs/index.js",
	"module": "./dist/esm/index.js",
	"exports": {
		".": {
			"require": "./dist/cjs/index.js",
			"import": "./dist/esm/index.js",
			"default": "./dist/esm/index.js"
		},
		"./*": {
			"require": "./dist/cjs/*.js",
			"import": "./dist/esm/*.js",
			"default": "./dist/esm/*.js"
		}
	}
}
