{
	"name": "@acala-network/chopsticks-utils",
	"version": "1.5.2",
	"author": "Acala Developers <hello@acala.network>",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=v22"
	},
	"scripts": {
		"clean": "rm -rf dist tsconfig.tsbuildinfo",
		"build": "bun run clean && ../../package-build.sh",
		"depcheck": "bunx depcheck"
	},
	"dependencies": {
		"@acala-network/chopsticks": "workspace:*",
		"@acala-network/chopsticks-core": "workspace:*",
		"@polkadot-labs/hdkd": "^0.0.32",
		"@polkadot-labs/hdkd-helpers": "^0.0.34",
		"@polkadot/api": "^17.0.2",
		"@polkadot/api-base": "^17.0.2",
		"@polkadot/keyring": "^14.0.3",
		"@polkadot/types": "^17.0.2",
		"@polkadot/util": "^14.0.3",
		"polkadot-api": "^3.3.0"
	},
	"devDependencies": {
		"@swc/cli": "0.8.2",
		"@swc/core": "^1.16.22",
		"typescript": "^7.0.2"
	},
	"files": [
		"dist/esm/**",
		"dist/cjs/**"
	],
	"main": "./dist/cjs/index.js",
	"module": "./dist/esm/index.js",
	"exports": {
		".": {
			"require": "./dist/cjs/index.js",
			"import": "./dist/esm/index.js",
			"default": "./dist/esm/index.js"
		},
		"./*": {
			"require": "./dist/cjs/*.js",
			"import": "./dist/esm/*.js",
			"default": "./dist/esm/*.js"
		}
	}
}
